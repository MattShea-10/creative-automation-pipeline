# Line endings are decided here rather than by whoever cloned the repo.
#
# The release workflow rebuilds static/tailwind-*.css on a Windows runner
# and compares the result with the committed copy, because both builds
# have to serve the same stylesheet. Git on Windows checks text files out
# as CRLF by default, so the checkout and the rebuild (which writes LF)
# differed on every single line, and the build failed on a difference
# that exists nowhere but in the working tree.
* text=auto eol=lf

# Anything whose bytes must not be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.psd binary
*.zip binary
*.dmg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mov binary
*.pdf binary
