# Copy this file to .env and fill in values as needed.
# The pipeline runs with NO keys at all (defaults to the free, keyless
# Pollinations.ai image provider, falling back to a local mock generator
# if there's no network). The variables below are only needed if you want
# to switch providers.

# Which image generation provider to use: mock | pollinations | huggingface
IMAGE_PROVIDER=pollinations

# Only required if IMAGE_PROVIDER=huggingface
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# Optional: HF model id to use for image generation
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Which Pollinations model to ask for. Left unset the endpoint picks its
# own, which in practice returns 768x768 no matter how large a size is
# requested -- so bigger output sizes get upscaled from that and look
# soft. Some models honour larger dimensions; try one here and check the
# size the results page reports.
POLLINATIONS_MODEL=
